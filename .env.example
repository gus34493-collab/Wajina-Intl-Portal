# ── Database ─────────────────────────────────────────────────────────────────
# Pooled connection — used by the Express app at runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connect_timeout=300

# Direct (non-pooled) connection — required by Prisma migrate
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?connect_timeout=300

# ── Express / Auth ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Frontend origin allowed by CORS (comma-separated for multiple origins)
# CORS_ORIGIN=https://your-production-domain.com

# ── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Wajina Portal <noreply@wajina.edu.ng>

# The domain/URL users click in the reset email — change when you go live
APP_URL=http://localhost:3000

# ── App (public) ───────────────────────────────────────────────────────────
# Exposed to the browser — used in payment redirects and password reset links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── DigitalOcean Spaces (report card PDF storage) ─────────────────────────
# Key/secret from DO dashboard → API → Spaces Access Keys
DO_SPACES_KEY=
DO_SPACES_SECRET=
# Format: https://{region}.digitaloceanspaces.com  (no bucket, no trailing slash)
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=wajina-report-cards

# ── Payments (Flutterwave) ─────────────────────────────────────────────────
# Secret key from your Flutterwave dashboard (Settings → API Keys)
FLW_SECRET_KEY=
# Used to verify webhook signatures — must match the hash set in Flutterwave dashboard
FLW_WEBHOOK_HASH=
