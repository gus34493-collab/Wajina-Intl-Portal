i# ── Database ─────────────────────────────────────────────────────────────────
# Pooled connection — used by the Express app at runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connect_timeout=300

# Direct (non-pooled) connection — required by Prisma migrate
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?connect_timeout=300

# ── Express / Auth ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Frontend origin allowed by CORS (comma-separated for multiple origins)
# CORS_ORIGIN=https://your-production-domain.com

# ── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Wajina Portal <noreply@wajina.edu.ng>

# The domain/URL users click in the reset email — change when you go live
APP_URL=http://localhost:3000
