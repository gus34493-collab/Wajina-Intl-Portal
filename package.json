{
  "name": "wajina-portal",
  "version": "1.0.0",
  "description": "Wajina International Schools Management Portal",
  "main": "server/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec \"ts-node --transpile-only\" server/index.ts",
    "dev:frontend": "esbuild main.jsx --bundle --outfile=dist-frontend/bundle.js --loader:.jsx=jsx --platform=browser --watch",
    "build:frontend": "esbuild main.jsx --bundle --outfile=dist-frontend/bundle.js --minify --loader:.jsx=jsx --platform=browser",
    "preview:frontend": "npx serve dist-frontend",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "seed": "ts-node server/seed.ts",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^3.0.0",
    "dompurify": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsdom": "^26.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "next": "^16.2.2",
    "pg": "^8.20.0",
    "puppeteer": "^24.40.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.10.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.19.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  }
}
